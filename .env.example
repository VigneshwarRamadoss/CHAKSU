# Shopify Storefront API Configuration
# Canonical public origin used by metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL="https://chaksu.vercel.app"

# Replace with your actual store domain (e.g., your-store.myshopify.com)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="your-store.myshopify.com"

# The public Storefront API access token
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN="your_storefront_access_token_here"

# Server-side newsletter provider/webhook. Never prefix the API token with NEXT_PUBLIC_.
NEWSLETTER_ENDPOINT="https://your-newsletter-provider.example/subscribe"
NEWSLETTER_API_TOKEN="your_server_side_api_token"
